{
  "name": "eras",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "assets": { "directory": "../web/dist" },
  // The zone is the only place a request can be turned away before it becomes a
  // billable one, so the world lives on the domain and nowhere else. Leaving the
  // workers.dev URL up would leave a door straight past the zone's rate limits.
  "routes": [{ "pattern": "eras.nathanarthur.com", "custom_domain": true }],
  // preview_urls only follows workers_dev on wrangler 4.44 and up, and the
  // dependency range here allows older ones. Say it rather than inherit it.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "WorldDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldDO"] }]
}
